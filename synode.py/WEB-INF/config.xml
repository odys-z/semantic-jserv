<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xml>
<configs>
  <t id="default" pk="k" columns="k,v">
    <c>
    	<!-- "windows" (or win32, rad32, radix32): auto keys in Radix32 (0-9A-V), on every synode, whatever its OS.
    		Auto keys prefix file names in the volume, and Windows file names are case-insensitive.
    		Read only by semantic-DA's DASemantext.radix64_32(). Radix32 keys never equal earlier
    		Radix64 ones (same digits, same values), as long as a sequence stays below 32^id-len. -->
    	<k>file-sys</k>
    	<v>radix32</v>
    </c>
    <c>
    	<k>id-len</k>
    	<v>4</v>
    </c>

	<!-- <c> <k>io.oz.syn.synode</k> <v>X</v> </c> -->

	<c>
		<!-- Class name of SUser Implementation -->
		<k>class-IUser</k>
		<v>io.oz.jserv.docs.syn.DocUser</v>
	</c>


	<c>
		<k>sync.log.on-verbose</k>
		<v>false</v>
	</c>
	<c>
		<k>ss-timeout-min</k>
		<v>60</v>
	</c>
	<c>
		<k>ss-timeout-min.debugMode</k>
		<v>false</v>
	</c>
	<c>
        <!-- empty for disabling db log -->
		<k>log-connId</k>
		<v></v>
	</c>

	<c>
		<k>exiftool</k>
		<v>exiftool</v>
	</c>
  </t>

</configs>
