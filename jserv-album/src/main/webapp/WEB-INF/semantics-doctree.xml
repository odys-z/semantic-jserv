<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xml>
<!-- Semantics of the doc-tree db (DoctreeDB). The same as doctree.jserv's test resource; the name is hard coded (DoctreeDBHelper.smtcs).
	fullpath args: parent field, sibling sort field, fullpath field, sort size
		(sort size: the only place configuring it; SemanticTree and the importer read it, DocNodeMeta.siblingWidth())
	fullpath2: experimental ShFullpath2 (semantic.DA 1.5.31), the same args; updates only by parent / sort
 -->
<semantics>
  <t id="semantics" pk="id" columns="id,smtc,tabl,pk,args">
	<s>
		<!-- doc id, unique across synodes: synode + '.' + auto key, e.g. X.000A,
			in Radix32 with config.xml file-sys = windows, id-len digits.
			args: pk, start, prefix (column synode) -->
		<id>docs.pk</id>
		<smtc>autopk</smtc>
		<tabl>s_docs</tabl>
		<pk>docId</pk>
		<args>docId,0,synode</args>
	</s>
	<s>
		<!-- node id: auto key, unique in the db, e.g. 00000A (Radix32, id-len digits), since doctree.jserv 0.1.4.
			Before fullpath2: a row's own key is generated before its fullpath is composed.
			The importer refers to a parent in the same insert by Resulving(s_docnodes, nid, i). -->
		<id>docnodes.pk</id>
		<smtc>autopk</smtc>
		<tabl>s_docnodes</tabl>
		<pk>nid</pk>
		<args>nid,0</args>
	</s>
	<s>
		<id>docnodes.fp</id>
		<smtc>fullpath2</smtc>
		<tabl>s_docnodes</tabl>
		<pk>nid</pk>
		<args>parentId,sort,fullpath,4</args>
	</s>
	<s>
		<!-- story id (since doctree.jserv 0.1.5): synode + '.S.' + auto key, e.g. X29.S.000A,
			never a doc's id (synode + '.' + auto key). args: pk, start, prefix (column synode), prefix (const S) -->
		<id>stories.pk</id>
		<smtc>autopk</smtc>
		<tabl>s_stories</tabl>
		<pk>storyId</pk>
		<args>storyId,0,synode,S</args>
	</s>
	<s>
		<!-- a story's block: auto key, unique in the db -->
		<id>storynodes.pk</id>
		<smtc>autopk</smtc>
		<tabl>s_storynodes</tabl>
		<pk>nid</pk>
		<args>nid,0</args>
	</s>
  </t>
</semantics>
